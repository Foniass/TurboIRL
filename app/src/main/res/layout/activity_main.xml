<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TurboIRL"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SectionTitle"
            android:text="Destination SRT (le PC avec OBS)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/srtHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:hint="Adresse (IP ou nom DynDNS)"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/srtPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Port"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/srtLatency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Latence (ms)"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true" />

        </LinearLayout>

        <EditText
            android:id="@+id/outMaxKbps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Débit vidéo max en sortie (kb/s), ex. 3000"
            android:importantForAutofill="no"
            android:inputType="number"
            android:singleLine="true" />

        <EditText
            android:id="@+id/audioKbps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Débit du son (kb/s), ex. 64"
            android:importantForAutofill="no"
            android:inputType="number"
            android:singleLine="true" />

        <EditText
            android:id="@+id/outMaxHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Résolution max en sortie (480 / 720 / 1080)"
            android:importantForAutofill="no"
            android:inputType="number"
            android:singleLine="true" />

        <EditText
            android:id="@+id/vpsToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jeton VPS (télémétrie et journal envoyés automatiquement)"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:singleLine="true" />

        <TextView
            android:id="@+id/obsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="OBS PC : …" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/obsStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lancer le stream OBS" />

            <Button
                android:id="@+id/obsStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Arrêter le stream OBS" />
        </LinearLayout>

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="Démarrer"
            android:textSize="18sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="Pilotage de la GoPro en Bluetooth" />

        <CheckBox
            android:id="@+id/goproEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="L'appli connecte la GoPro au hotspot du téléphone et lance le live toute seule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/goproSsid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nom du hotspot du téléphone (SSID)"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <EditText
                android:id="@+id/goproPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Mot de passe du hotspot"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/goproResolution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Résolution (480/720/1080)"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true" />

            <EditText
                android:id="@+id/goproMaxKbps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Débit max (kb/s)"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>

        <Button
            android:id="@+id/tethering"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Partage de connexion éteint : ouvrir les réglages" />

        <TextView
            android:id="@+id/goproStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="14sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="URL à régler dans la GoPro" />

        <TextView
            android:id="@+id/rtmpUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="État" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="14sp" />

        <Button
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Autoriser l'exécution en arrière-plan" />

        <TextView
            style="@style/SectionTitle"
            android:text="Journal" />

        <Button
            android:id="@+id/share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Partager le journal (Discord…)" />

        <Button
            android:id="@+id/sendVps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Envoyer le journal au VPS maintenant" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
