<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Onglets : SETUP (tous les réglages et l'état) / LIVE (flou, commandes, tchat) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabSetup"
            style="@style/Tab"
            android:text="SETUP" />

        <TextView
            android:id="@+id/tabLive"
            style="@style/Tab"
            android:text="LIVE" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/setupTab"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TurboIRL"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:text="Démarrer"
            android:textSize="18sp" />

        <Button
            android:id="@+id/update"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="Mettre à jour"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/versions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textColor="#BBBBBB"
            android:textSize="12sp" />

        <!-- ============================ État ============================ -->
        <TextView
            android:id="@+id/secStateHeader"
            style="@style/SectionHeader"
            android:text="État" />

        <LinearLayout
            android:id="@+id/secStateBody"
            style="@style/SectionBody">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/goproStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/linksStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/tethering"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Partage de connexion éteint : ouvrir les réglages" />

            <Button
                android:id="@+id/battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Autoriser l'exécution en arrière-plan" />

            <TextView
                style="@style/SubTitle"
                android:text="OBS sur le PC" />

            <TextView
                android:id="@+id/obsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:text="OBS PC : …" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/obsStart"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Lancer OBS" />

                <Button
                    android:id="@+id/obsStop"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Arrêter OBS" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================ Destination ============================ -->
        <TextView
            android:id="@+id/secDestHeader"
            style="@style/SectionHeader"
            android:text="Serveur SRT (relais du VPS)" />

        <LinearLayout
            android:id="@+id/secDestBody"
            style="@style/SectionBody">

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Adresse du serveur" />
                <EditText
                    android:id="@+id/srtHost"
                    style="@style/FieldInput"
                    android:hint="turboirl.mathisjacqueline.com"
                    android:inputType="textPassword" />
            </LinearLayout>

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Port SRT" />
                <EditText
                    android:id="@+id/srtPort"
                    style="@style/FieldInput"
                    android:hint="8890"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Latence (ms)" />
                <EditText
                    android:id="@+id/srtLatency"
                    style="@style/FieldInput"
                    android:hint="12000"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================ Connexions ============================ -->
        <TextView
            android:id="@+id/secConnHeader"
            style="@style/SectionHeader"
            android:text="Connexions (forfaits)" />

        <LinearLayout
            android:id="@+id/secConnBody"
            style="@style/SectionBody">

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Forfait 5G de ce téléphone (Go)" />
                <EditText
                    android:id="@+id/cellPlanGb"
                    style="@style/FieldInput"
                    android:hint="200"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Forfait du partage de connexion (Go)" />
                <EditText
                    android:id="@+id/wifiPlanGb"
                    style="@style/FieldInput"
                    android:hint="130"
                    android:inputType="number" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:text="Le flux est réparti entre la 5G du téléphone et le Wi-Fi du partage de connexion de l'autre téléphone au prorata des forfaits, la qualité d'abord ; le son part toujours sur les deux. 0 = ce lien ne sert que de secours." />
        </LinearLayout>

        <!-- ============================ Vidéo ============================ -->
        <TextView
            android:id="@+id/secVideoHeader"
            style="@style/SectionHeader"
            android:text="Vidéo envoyée" />

        <LinearLayout
            android:id="@+id/secVideoBody"
            style="@style/SectionBody">

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Débit vidéo max (kb/s)" />
                <EditText
                    android:id="@+id/outMaxKbps"
                    style="@style/FieldInput"
                    android:hint="3500"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Résolution max (480/720/1080)" />
                <EditText
                    android:id="@+id/outMaxHeight"
                    style="@style/FieldInput"
                    android:hint="720"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Débit du son (kb/s)" />
                <EditText
                    android:id="@+id/audioKbps"
                    style="@style/FieldInput"
                    android:hint="64"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================ GoPro ============================ -->
        <TextView
            android:id="@+id/secGoproHeader"
            style="@style/SectionHeader"
            android:text="GoPro" />

        <LinearLayout
            android:id="@+id/secGoproBody"
            style="@style/SectionBody">

            <CheckBox
                android:id="@+id/goproEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilotage automatique en Bluetooth (hotspot, live)" />

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Hotspot du téléphone (nom)" />
                <EditText
                    android:id="@+id/goproSsid"
                    style="@style/FieldInput"
                    android:hint="nom exact"
                    android:inputType="textNoSuggestions" />
            </LinearLayout>

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Mot de passe du hotspot" />
                <EditText
                    android:id="@+id/goproPassword"
                    style="@style/FieldInput"
                    android:hint="8 caractères min."
                    android:inputType="textPassword" />
            </LinearLayout>

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Résolution caméra (480/720/1080)" />
                <EditText
                    android:id="@+id/goproResolution"
                    style="@style/FieldInput"
                    android:hint="1080"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Débit caméra max (kb/s)" />
                <EditText
                    android:id="@+id/goproMaxKbps"
                    style="@style/FieldInput"
                    android:hint="8000"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rtmpBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SubTitle"
                    android:text="Sans pilotage : URL à régler dans la GoPro (Quik → Live → RTMP)" />

                <TextView
                    android:id="@+id/rtmpUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================ VPS et journal ============================ -->
        <TextView
            android:id="@+id/secVpsHeader"
            style="@style/SectionHeader"
            android:text="VPS et journal" />

        <LinearLayout
            android:id="@+id/secVpsBody"
            style="@style/SectionBody">

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Jeton VPS" />
                <EditText
                    android:id="@+id/vpsToken"
                    style="@style/FieldInput"
                    android:hint="envoi automatique de la télémétrie"
                    android:inputType="textPassword" />
            </LinearLayout>

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Chaîne Twitch (tchat de l'onglet LIVE)" />
                <EditText
                    android:id="@+id/twitchChannel"
                    style="@style/FieldInput"
                    android:hint="nom de la chaîne"
                    android:inputType="textNoSuggestions" />
            </LinearLayout>

            <Button
                android:id="@+id/sendVps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Envoyer le journal au VPS maintenant" />

            <CheckBox
                android:id="@+id/testChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Versions de test (dernière publiée au lieu de la stable)" />

            <Button
                android:id="@+id/share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Partager le journal (Discord…)" />
        </LinearLayout>

        <!-- ============================ Test (canal test seulement) ============================ -->
        <TextView
            android:id="@+id/secTestHeader"
            style="@style/SectionHeader"
            android:visibility="gone"
            android:text="Banc d'essai" />

        <LinearLayout
            android:id="@+id/secTestBody"
            style="@style/SectionBody"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/testSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Source de test à la place de la GoPro (vidéo synthétique en boucle)" />

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Pannes 5G" />
                <EditText
                    android:id="@+id/impairCell"
                    style="@style/FieldInput"
                    android:hint="pertes%,délai ms,kb/s max,toutes les s,durée s"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:text="Pannes Wi-Fi" />
                <EditText
                    android:id="@+id/impairWifi"
                    style="@style/FieldInput"
                    android:hint="ex. 5,200,0,60/8 → 5 % de pertes, +200 ms, coupure 8 s toutes les 60 s"
                    android:inputType="text" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:text="Format : pertes %, délai ms, débit max kb/s, période s, durée s (vide = rien). Ex. « 0,0,0,60,8 » = coupure de 8 s toutes les 60 s." />
        </LinearLayout>

        <CheckBox
            android:id="@+id/showSecrets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:text="Afficher les champs masqués (adresse, mots de passe, jeton) — à décocher en stream" />
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/liveTab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/liveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Twitch : …" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/blur"
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_weight="1"
                android:textSize="20sp"
                android:text="FLOUTER" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/orderPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Prix (€)"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <Button
                    android:id="@+id/orderGo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="GO" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/orderStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chatState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:text="Tchat : …" />

            <Button
                android:id="@+id/chatLogin"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:text="Se connecter à Twitch" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="#121212"
            android:fillViewport="true">

            <TextView
                android:id="@+id/chatLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textColor="#EEEEEE"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/chatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Message"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="500" />

            <Button
                android:id="@+id/chatSend"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:text="Envoyer" />
        </LinearLayout>

        <TextView
            android:id="@+id/chatHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#BBBBBB"
            android:textSize="12sp"
            android:text="Renseigne la chaîne Twitch dans SETUP (section VPS et journal) pour afficher le tchat." />
    </LinearLayout>
    </FrameLayout>
</LinearLayout>
